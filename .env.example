# ==============================================================================
# Heart Failure Mortality Risk Predictor — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# .env is already listed in .gitignore.
# ==============================================================================

# ==============================================================================
# Primary Database Connection: PostgreSQL (Local & Render Production)
# ==============================================================================
# For Local PostgreSQL 18 (matching Render):
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_LOCAL_PASSWORD@localhost:5433/heartmortality

# Or configure via individual PostgreSQL variables:
# PGHOST=localhost
# PGPORT=5433
# PGDATABASE=heartmortality
# PGUSER=postgres
# PGPASSWORD=YOUR_LOCAL_PASSWORD

# For Production Render deployment:
# Render automatically injects DATABASE_URL=postgres://... into the environment.

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Email & SMTP Settings (Email OTP Verification)
# ------------------------------------------------------------------------------

# SMTP Server hostname (e.g. smtp.gmail.com, smtp.office365.com, or mail.hospital.org)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@cardiopredict.org
SMTP_FROM_NAME=CardioPredict Clinical Portal
SMTP_USE_TLS=yes

# ------------------------------------------------------------------------------
# Administrator & Security Settings
# ------------------------------------------------------------------------------

# Secret key for signing doctor JWT access tokens (used by auth/session_service.py)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-64-char-string

# Secret key used for signing administrator session tokens (used by admin/security.py)
# Use a DIFFERENT value from JWT_SECRET_KEY in production
ADMIN_SECRET_KEY=change-this-in-production-to-a-different-secure-random-64-char-string

# Initial Administrator Credentials (provision explicitly or auto-seeded on startup)
ADMIN_EMAIL=debashish.g333@gmail.com
ADMIN_PASSWORD=admin_debashish123
ADMIN_USERNAME=debashish.g333
ADMIN_FULL_NAME=Hospital Administrator
ADMIN_RECOVERY_EMAIL=

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------

# Set to "development" or "production"
APP_ENV=development

# FastAPI application port
PORT=8000
