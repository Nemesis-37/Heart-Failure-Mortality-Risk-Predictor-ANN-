# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
.venv/
ENV/

# Jupyter notebooks
.ipynb_checkpoints/

# Environment files — NEVER commit .env (contains real passwords/secrets)
.env

# Allow .env.example (no real credentials — safe to commit)
!.env.example

# IDE / editor settings
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp

# SQLite development fallback databases (auto-created when SQL Server is unavailable)
*.db
*.db-shm
*.db-wal

# Uploaded medical credential documents (sensitive — never commit)
storage/medical_documents/

# Dataset (large CSV — optional exclude)
# dataset/
